# Copy this file to .env.local and fill in your keys. Never commit .env.local.
# All keys are read server-side only (no NEXT_PUBLIC_ prefix), so they never reach the browser.

# --- Market data (required) ---------------------------------------------
# Twelve Data free "Basic" plan: https://twelvedata.com/pricing
TWELVE_DATA_API_KEY=

# --- Macro data (recommended) -------------------------------------------
# FRED API key (free): https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# --- Economic calendar (optional) ---------------------------------------
# Finnhub key: https://finnhub.io/register
# Note: on many free keys /calendar/economic returns 403; the app then uses the fallback below.
FINNHUB_API_KEY=
# Fallback calendar when Finnhub is missing/denied: "forexfactory" (free public weekly JSON) or "none"
CALENDAR_FALLBACK=forexfactory
# "strict" (default): NO TRADE when no calendar loads, since the 30-minute news rule can't be checked.
# "warn": allow trades with a warning and lower confidence.
NEWS_GATE=strict

# --- AI model ------------------------------------------------------------
# AI_PROVIDER: "anthropic" (default) or "openai" (any OpenAI-compatible Chat Completions API)
AI_PROVIDER=
# Leave empty for the provider default (anthropic: claude-haiku-5-5, openai: gpt-4.1-mini)
AI_MODEL=
ANTHROPIC_API_KEY=
# Only needed when AI_PROVIDER=openai
OPENAI_API_KEY=
# Optional override for OpenAI-compatible hosts, e.g. https://api.groq.com/openai/v1
AI_BASE_URL=
# Anthropic only. "off" (default) disables thinking for speed; "auto" uses the model default
# (Claude 5-family models think by default, which can push requests past the 10 s budget).
AI_THINKING=off

# --- Tuning (optional) ---------------------------------------------------
# Seconds to cache macro data in memory (5-300); candles are capped at 120 s
CACHE_TTL_SECONDS=90
# Max analyze requests per IP per minute, per server instance (1-120)
RATE_LIMIT_PER_MINUTE=30

# --- SMC-lite / SMA filter (optional) -----------------------------------
# Master switch. When false, signals are left exactly unchanged (useful for A/B testing).
SMC_ENABLED=true
# When true, deeply counter-trend setups are hard-blocked into NO_TRADE instead of just penalised.
SMC_HARD_BLOCK=false
# Confidence penalties (stack, never raise confidence). Clamped to >=0 integers.
SMC_PEN_ZONE=10
SMC_PEN_CHOCH=15
SMC_PEN_SWEEP=10
SMC_PEN_FVG=5
SMC_PEN_SMA=5
# Thresholds (all numbers; windows are candle counts on the relevant timeframe).
SMC_ZONE_DISCOUNT=35
SMC_ZONE_PREMIUM=65
SMC_SWEEP_WINDOW=6
SMC_SWEEP_ATR_MULT=0.1
SMC_FVG_WINDOW=60
SMC_FVG_ATR=3
SMC_CROSS_WINDOW=20
SMC_CHOCH_WINDOW=10
SMC_HARD_BLOCK_ZONE=20

# --- Telegram alerts (optional; used only by POST /api/cron/scan) --------
# Create a bot with @BotFather, then message it once and read your chat id from
# https://api.telegram.org/bot<TOKEN>/getUpdates  (see README "Alerts").
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Shared secret the scheduler sends as "Authorization: Bearer <CRON_SECRET>". Generate: openssl rand -hex 32
# When empty the cron endpoint rejects every request.
CRON_SECRET=
# Secret Telegram echoes back on every webhook call (header X-Telegram-Bot-Api-Secret-Token).
# 16-256 chars of A-Z a-z 0-9 _ - ; generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# When empty the webhook rejects every request. Register it once with: npx tsx scripts/set-webhook.ts <APP_URL>
TELEGRAM_WEBHOOK_SECRET=
# Closed calls per page for /history (1-10)
CALLS_HISTORY_PAGE_SIZE=5
# Alert only at or above this confidence (0-100)
ALERT_MIN_CONFIDENCE=60
# No repeat alert for the same mode+side within this many hours (1-72), unless the entry moved more than 1 x ATR
ALERT_COOLDOWN_HOURS=3
# true = alert only on weekdays 07:00-20:00 UTC (London + New York)
ALERT_SESSIONS_ONLY=false
# Upstash Redis REST (either pair; the Vercel Upstash/KV integration sets KV_REST_API_*)
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
